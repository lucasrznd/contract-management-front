# Base URL of contract-management-api (https://github.com/lucasrznd/contract-management-api)
VITE_API_BASE_URL=http://localhost:8080/api

# Uploads seller photos as files (POST /sellers/photo). Leave it off until the API supports it;
# meanwhile the photo is saved as a URL typed in the form.
VITE_SELLER_PHOTO_UPLOAD=false
